{
  "name": "@zktx.io/sui-mcp",
  "version": "0.8.2",
  "mcpName": "io.github.zktx-mcp/sui-mcp",
  "description": "Sui MCP is a local-first toolkit for helping AI applications and users inspect Sui DeFi actions before execution.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sui-mcp": "./dist/runtime/start.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/MCP_SETUP.md",
    "docs/MCP_TOOLS.md",
    "docs/AGENT_BEHAVIOR.md",
    "docs/WALLET_CONNECTION.md",
    "docs/LOCAL_DB_ARCHITECTURE.md",
    "docs/SDK_API.md",
    "docs/SIGNABLE_ADAPTER_CONTRACT.md",
    "docs/TRANSACTION_ACTIVITY_LOG.md",
    "docs/UTILITY_INDEX.md",
    "protocols/deepbook-v3.md",
    "protocols/deepbook-margin.md",
    "LICENSE",
    "LICENSES/"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sui",
    "deepbook",
    "transaction-review",
    "wallet-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zktx-mcp/sui-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zktx-mcp/sui-mcp/issues"
  },
  "homepage": "https://github.com/zktx-mcp/sui-mcp#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node node_modules/typescript/bin/tsc -p tsconfig.build.json && tsx scripts/build-mcp-ui.ts",
    "prepublishOnly": "npm run release:check",
    "release:check": "tsx scripts/release-check.ts",
    "smoke:mainnet": "node dist/runtime/smokeMainnetRead.js",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "generate:deepbook-registry": "tsx scripts/generate-deepbook-registry.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@mysten/deepbook-v3": "2.6.4",
    "@mysten/sui": "2.35.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@walletconnect/sign-client": "2.26.0",
    "@walletconnect/types": "2.26.0",
    "@walletconnect/utils": "2.26.0",
    "@zktx.io/ptb-model": "0.5.0",
    "better-sqlite3": "13.0.3",
    "lightweight-charts": "5.2.1",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "overrides": {
    "mermaid@12.1.0": {
      "katex": "0.19.0"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
